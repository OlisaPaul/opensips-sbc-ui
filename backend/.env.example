PORT=3000
BACKEND_HOST=127.0.0.1
FRONTEND_ORIGIN=http://localhost:5173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=opensips
DB_PASSWORD=change-me
DB_NAME=opensips

MI_TRANSPORT=cli
MI_CLI_PATH=/usr/bin/opensips-cli
MI_URL=http://127.0.0.1:8888/mi
MI_TIMEOUT_MS=3000
MI_ENABLED=true

# Local OpenSIPS SIP listener used as the Contact URI for new registrations.
# The UI can override this for an individual trunk.
SIP_BINDING_IP=10.81.0.194
SIP_BINDING_PORT=5060

CREDENTIAL_ENCRYPTION_KEY=replace-with-a-long-random-production-secret
