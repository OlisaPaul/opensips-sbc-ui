# Copy this file to /etc/opensips-sbc-ui/deploy.env on the server.
# Keep the deployed copy root-owned with mode 600; it contains a password.

DOMAIN=192.168.1.50
SELF_SIGNED=true
EMAIL=

APP_DIR=/opt/opensips-sbc-ui
BACKEND_PORT=3000

BASIC_AUTH_USER=admin
BASIC_AUTH_PASSWORD='replace-with-a-strong-password'

SKIP_DB_PREFLIGHT=false
